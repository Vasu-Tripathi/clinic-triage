# Copy to .env.local and fill in. Never commit .env.local.
# Owner/superuser connection — used ONLY by `npm run db:setup` to create schema + seed
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/clinic_triage
# Low-privilege runtime connection used by the Next.js API (role is created by db:setup)
DB_APP_PASSWORD=CHANGE_ME_TOO
DATABASE_URL=postgres://clinic_app:CHANGE_ME_TOO@localhost:5432/clinic_triage
# 32+ random characters, e.g.  openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
# Optional: folder holding Xenova/all-MiniLM-L6-v2 for fully offline embedding
# EMBEDDING_MODEL_DIR=./models
